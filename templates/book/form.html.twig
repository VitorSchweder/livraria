{% extends 'base.html.twig' %}

{% set heading = book.id ? 'Editar livro' : 'Novo livro' %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('book_index') }}">Livros</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ heading }}</li>
        </ol>
    </nav>

    <div class="card card-form">
        <div class="card-header"><h1 class="h4 mb-0">{{ heading }}</h1></div>
        <div class="card-body">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="row g-3">
                    <div class="col-md-8">{{ form_row(form.title) }}</div>
                    <div class="col-md-4">{{ form_row(form.publisher) }}</div>
                    <div class="col-md-4">{{ form_row(form.edition) }}</div>
                    <div class="col-md-4">{{ form_row(form.publicationYear) }}</div>
                    <div class="col-md-4">{{ form_row(form.price) }}</div>
                    <div class="col-md-6">{{ form_row(form.authors) }}</div>
                    <div class="col-md-6">{{ form_row(form.subjects) }}</div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
                    <a href="{{ path('book_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

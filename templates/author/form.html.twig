{% extends 'base.html.twig' %}

{% set heading = author.id ? 'Editar autor' : 'Novo autor' %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('author_index') }}">Autores</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ heading }}</li>
        </ol>
    </nav>

    <div class="card card-form card-narrow">
        <div class="card-header"><h1 class="h4 mb-0">{{ heading }}</h1></div>
        <div class="card-body">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar</button>
                    <a href="{{ path('author_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

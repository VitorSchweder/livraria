{% extends 'base.html.twig' %}

{% block title %}Relatório de livros por autor{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h1 class="h3 mb-0"><i class="bi bi-file-earmark-bar-graph me-2"></i>Livros por autor</h1>
        <a href="{{ path('report_books_by_author_pdf', selectedAuthor ? {author: selectedAuthor} : {}) }}" class="btn btn-primary" target="_blank">
            <i class="bi bi-filetype-pdf"></i> Gerar PDF
        </a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-sm-8 col-md-5">
            <label for="author-filter" class="form-label">Autor</label>
            <select id="author-filter" name="author" class="form-select">
                <option value="">Todos os autores</option>
                {% for author in authors %}
                    <option value="{{ author.id }}" {{ author.id == selectedAuthor ? 'selected' }}>{{ author.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="card card-summary"><div class="card-body"><small class="text-body-secondary text-uppercase">Autores</small><div class="h4 mb-0">{{ report.authorCount }}</div></div></div></div>
        <div class="col-sm-4"><div class="card card-summary"><div class="card-body"><small class="text-body-secondary text-uppercase">Livros distintos</small><div class="h4 mb-0">{{ report.distinctBooks }}</div></div></div></div>
        <div class="col-sm-4"><div class="card card-summary"><div class="card-body"><small class="text-body-secondary text-uppercase">Valor do acervo</small><div class="h4 mb-0">{{ report.collectionValue|format_currency('BRL') }}</div></div></div></div>
    </div>

    {% for group in report.groups %}
        <div class="card mb-3 author-group">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0"><i class="bi bi-person-fill me-1"></i>{{ group.name }}</h2>
                <span class="small text-body-secondary">{{ group.bookCount }} livro(s) · {{ group.totalPrice|format_currency('BRL') }}</span>
            </div>
            {% if group.books is empty %}
                <div class="card-body text-body-secondary fst-italic">Nenhum livro cadastrado para este autor.</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Título</th>
                                <th>Editora</th>
                                <th class="text-center">Edição</th>
                                <th class="text-center">Ano</th>
                                <th>Assuntos</th>
                                <th>Coautores</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in group.books %}
                                <tr>
                                    <td>{{ row.title }}</td>
                                    <td>{{ row.publisher }}</td>
                                    <td class="text-center">{{ row.edition }}ª</td>
                                    <td class="text-center">{{ row.publicationYear }}</td>
                                    <td>{{ row.subjects|join(', ') }}</td>
                                    <td>{{ row.coAuthors is empty ? '—' : row.coAuthors|join(', ') }}</td>
                                    <td class="text-end text-nowrap">{{ row.price|format_currency('BRL') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="alert alert-info">Nenhum autor cadastrado.</div>
    {% endfor %}
{% endblock %}

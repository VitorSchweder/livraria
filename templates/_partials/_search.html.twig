<form method="get" class="mb-3" role="search">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="search" name="search" value="{{ search }}" class="form-control" placeholder="{{ placeholder }}" aria-label="Buscar">
        <button class="btn btn-outline-primary" type="submit">Buscar</button>
        {% if search %}
            <a class="btn btn-outline-secondary" href="{{ path(app.request.attributes.get('_route')) }}">Limpar</a>
        {% endif %}
    </div>
</form>
